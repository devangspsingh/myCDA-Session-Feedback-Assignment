# Django Backend Environment Configuration Template
# Duplicate this file to .env and set your production values

DEBUG=False
SECRET_KEY=replace-with-a-secure-random-secret-key
ALLOWED_HOSTS=yourdomain.com,api.yourdomain.com,localhost,127.0.0.1
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://dashboard.yourdomain.com
